# Core
MONGOOSE_DB_PATH=./data/mongoose.sqlite3
MONGOOSE_HOST=127.0.0.1
MONGOOSE_PORT=8765
MONGOOSE_TIMEZONE=Europe/London
MONGOOSE_HOME_LAT=51.5074
MONGOOSE_HOME_LON=-0.1278

# Local model runtime
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Role-based models, all pinned to Q4_K_M for a 24 GB base M4.
# chat = persona/default voice (Gemma, warmer); tool = tool-routing/reasoning;
# code = coding, loaded on demand.
# By default the tool planner uses the SAME model as chat, so one model stays
# resident (no multi-GB swap per tool turn on a 24GB box) and tool calls are
# fast and reliable. To use a dedicated tool model instead, uncomment the line
# below and pull it first (it will swap with chat in memory on 24GB).
OLLAMA_CHAT_MODEL=gemma4:26b-a4b-it-q4_K_M
# OLLAMA_TOOL_MODEL=gpt-oss:20b
OLLAMA_CODE_MODEL=qwen2.5-coder:14b-instruct-q4_K_M
# How long Ollama keeps a model resident. -1 = keep loaded permanently so the
# ~15s load is paid once and every later chat is warm (no cold start). Cost on a
# 24GB machine: ~17GB RAM pinned, leaving ~7GB for the OS. Use 10m to unload when
# idle, or 0 to unload after each request, if you need that RAM back.
OLLAMA_KEEP_ALIVE=-1
# Disable model "thinking" mode (Gemma 4 etc.). Off = faster replies and the
# answer reliably lands in content, not a hidden thinking field. Set true for
# deeper reasoning on hard questions.
OLLAMA_THINK=false
# Model-assisted memory: after a chat turn, let the local model propose durable
# facts and store high-confidence ones automatically. Default on.
MEMORY_AUTO_EXTRACT=true
# Optional: legacy single-model alias. Defaults to OLLAMA_CHAT_MODEL if unset.
# OLLAMA_MODEL=gemma4:26b-a4b-it-q4_K_M

# Home Assistant
HA_URL=
HA_TOKEN=
HA_TIMEOUT_SECONDS=4

# Alexa fallback bridge. Leave blank until a deliberate bridge exists.
ALEXA_FALLBACK_URL=
ALEXA_FALLBACK_TOKEN=
ALEXA_TIMEOUT_SECONDS=5

# ntfy optional push layer
NTFY_URL=http://127.0.0.1:8090
NTFY_TOPIC=mongoose-private-topic
NTFY_TOKEN=

# Weather
WEATHER_PROVIDER_ORDER=open_meteo,tomorrow,metoffice,weatherkit
WEATHER_CURRENT_TTL_SECONDS=600
WEATHER_MINUTELY_TTL_SECONDS=300
WEATHER_HOURLY_TTL_SECONDS=2700
TOMORROW_API_KEY=
METOFFICE_API_KEY=
WEATHERKIT_TEAM_ID=
WEATHERKIT_SERVICE_ID=
WEATHERKIT_KEY_ID=
WEATHERKIT_PRIVATE_KEY_PATH=

# IMAP, including Proton Mail Bridge
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_USE_SSL=true

# Google Calendar
GOOGLE_CLIENT_SECRETS_PATH=./secrets/google-client-secrets.json
GOOGLE_TOKEN_PATH=./secrets/google-token.json

# Microsoft Graph
MS_CLIENT_ID=
MS_TENANT_ID=common
MS_TOKEN_CACHE=./secrets/msal-token-cache.bin

# Cloud escalation (optional, off by default). Local first; if a chat turn
# looks uncertain AND the request opts in (allow_cloud=true), Mongoose escalates
# to an instant cloud model: Anthropic Haiku first, then OpenAI nano, then optional Google fallback.
CLOUD_ESCALATION_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_INSTANT_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_INSTANT_MODEL=gpt-5.4-nano
# Optional Google/Gemini instant tier (cheapest current option).
GOOGLE_API_KEY=
GOOGLE_INSTANT_MODEL=gemini-2.5-flash-lite
# Provider order for escalation. Default honours Claude-first; set to
# google,anthropic,openai for cheapest-first. Only keyed providers run.
# CLOUD_PROVIDER_ORDER is also accepted as a compatibility alias.
CLOUD_ESCALATION_ORDER=anthropic,openai,google
# Hard per-turn budget in pence (GBP). A turn estimated to cost more is refused
# before any cloud call is made. Output is capped so worst-case cost is bounded.
CLOUD_TURN_BUDGET_PENNIES=2.0
CLOUD_MAX_OUTPUT_TOKENS=600

# Weather prefetch loop (optional autonomy). Run scripts/weather_prefetch_loop.sh
# alongside the server to refresh the weather cache on a schedule, so answers come
# from fresh cache instead of fetching at prompt time. The loop reads the interval
# below; start/stop it yourself (e.g. as a launchd/systemd job or a background
# process) rather than via a flag.
WEATHER_PREFETCH_INTERVAL_SECONDS=300

# API access control. By default sensitive routes (/setup, /home/command,
# /memory, /files/index, ingest, /conversation) are localhost-only. To allow
# them from other hosts, set both of these and send the token as the
# X-Mongoose-Token header. Leave unset for the safe default.
MONGOOSE_ALLOW_REMOTE=false
MONGOOSE_API_TOKEN=

# --- Owner / bus ---
# Identity used for bus messages and the daily brief recipient.
MONGOOSE_OWNER_ID=alex
# Comma-separated extra roots that bus_share_file may copy FROM (data dir is always allowed).
# MONGOOSE_SHARED_FILE_ROOTS=/Users/alex/projects,/Users/alex/Documents

# --- Build runner (overnight prototyping engine) ---
# Path/command for the Claude Code CLI used to review/fix build steps.
CLAUDE_CODE_CMD=claude
# Per-step ceiling in seconds (wraps the headless Claude Code call).
BUILD_STEP_TIMEOUT_S=1800
# Max Claude Code calls per build run (local drafts are unlimited/free).
BUILD_CODE_CALL_BUDGET=40

# --- Voice (mongoose voice) ---
# Text-to-speech command (macOS `say` by default). Replies print if absent.
MONGOOSE_TTS_CMD=say
# Optional named voice and speech rate for `say` (blank = system defaults).
# MONGOOSE_TTS_VOICE=Daniel
# MONGOOSE_TTS_RATE=190
# Whisper model used for --mic speech-to-text (needs sox/rec + a whisper CLI).
MONGOOSE_STT_MODEL=base.en
# Wake word for `mongoose voice --session` wake-word mode.
MONGOOSE_WAKE_WORD=mongoose

# --- Build runner safety / limits (v0.11.2) ---
# Wall-clock ceiling for one build run, seconds (default 43200 = 12h).
BUILD_RUN_MAX_SECONDS=43200

# NOTE: do not commit or ship a real .env. bootstrap copies this file to .env on
# first run; a shipped .env would shadow it and leave you with a stub.

# --- Voice mic tuning (mongoose voice --session) ---
# Trigger/stop threshold for sox silence detection. Raise for a noisy room
# (e.g. 4%), lower for a quiet mic (e.g. 1%). Default 2%.
MONGOOSE_MIC_THRESHOLD=2%
# Seconds of trailing silence that end a turn. Default 1.5.
MONGOOSE_MIC_SILENCE_S=1.5

# --- Daily brief: selected home-state ---
# Comma-separated Home Assistant entity ids the brief may READ (read-only) to
# surface notable state (a door left unlocked, heating off before bad weather).
# Empty by default: home-state in the brief is opt-in and a deliberate selection,
# not a dump of every entity. Example:
# MONGOOSE_BRIEF_HOME_ENTITIES=lock.back_door,cover.garage_door,climate.hall
MONGOOSE_BRIEF_HOME_ENTITIES=

# --- Model architecture: one speaker, silent workers -------------------------
# Defaults keep a single conversation owner (Gemma 26B) that also serves as the
# tool/research model, so a stock setup is unchanged. Set a separate research
# worker to use the supervisor/specialist pattern (see docs/MODEL_ARCHITECTURE.md).
# Only the conversation owner ever speaks to the user; workers return evidence.
# MONGOOSE_CONVERSATION_OWNER=gemma4:26b-a4b-it-q4_K_M   # the one model that speaks
# OLLAMA_RESEARCH_MODEL=qwen3.5:9b                       # silent research worker
# MONGOOSE_BIG_FALLBACK=gemma4:26b-a4b-it-q4_K_M         # high-stakes synthesis fallback
# MONGOOSE_SPEAKER_POLICY=owner_only                     # enforced; the only mode
# After setting a separate worker, verify both stay co-resident on your machine:
#   mongoose doctor --models

# --- Web search for the research worker (SearXNG, opt-in) --------------------
# Empty = disabled (research worker is local-only). Set to your self-hosted
# SearXNG instance to let the worker augment LOCAL results with web snippets,
# but only when local retrieval is thin (web is a fallback, not a default).
# Enable the json format in your SearXNG settings.yml (search: formats: [html, json]).
# LAN/private URLs are allowed over http (you opted in by setting them); public
# instances must use https. Snippets only, no page fetching.
# Web search ships ON by default via a LOCAL SearXNG container (docker compose service
# "searxng", bound to 127.0.0.1:8888). Local-first: queries route through SearXNG on THIS
# machine. Override to point elsewhere, or set empty to turn web search OFF.
MONGOOSE_SEARXNG_URL=http://127.0.0.1:8888

# --- HTTPS for the cockpit (unlocks browser voice on LAN phones/tablets) ------
# Browser mic capture needs https. Generate a cert with scripts/make_cert.sh
# (mkcert preferred), then point these at the files and run: mongoose serve --tls
# When both are set, https is auto-on. See docs/HTTPS.md.
# MONGOOSE_TLS_CERTFILE=/path/to/certs/mongoose.pem
# MONGOOSE_TLS_KEYFILE=/path/to/certs/mongoose-key.pem

# --- Remote reach (dynamic DNS / Tailscale) , set via `mongoose ddns setup` ---
# DDNS_PROVIDER=            # tailscale | duckdns | dynu | noip | cloudflare
# DDNS_ENABLED=false
# DuckDNS:
# DDNS_DUCKDNS_DOMAIN=
# DDNS_DUCKDNS_TOKEN=
# Dynu:
# DDNS_DYNU_HOSTNAME=
# DDNS_DYNU_USERNAME=
# DDNS_DYNU_PASSWORD=
# No-IP:
# DDNS_NOIP_HOSTNAME=
# DDNS_NOIP_USERNAME=
# DDNS_NOIP_PASSWORD=
# Cloudflare:
# DDNS_CLOUDFLARE_TOKEN=
# DDNS_CLOUDFLARE_ZONE_ID=
# DDNS_CLOUDFLARE_RECORD_NAME=

# --- Protocol v3: three-agent Home Assistant coordination (Mongoose + Claude Code + HA Assist) ---
# Off by default. Enable only when you want Mongoose to read the Pi coordination bus and drain voicemail.
# All household actions stay approval-gated even when enabled.
# PROTOCOL_V3_ENABLED=false
# The Pi running Home Assistant + the coordination bus. PI_SSH_HOST is like "pi@raspberrypi.local".
# PI_SSH_PORT defaults to 22. Use EITHER a key (PI_SSH_KEY=path to private key) OR a password
# (PI_SSH_PASSWORD=...); a real key always wins if both are set. PI_CONFIG_DIR is HA's /config on the Pi.
# PI_SSH_HOST=
# PI_SSH_PORT=22
# PI_SSH_KEY=
# PI_SSH_PASSWORD=
# PI_CONFIG_DIR=/config

# --- Google OAuth redirect port ---
# The local port the Google sign-in callback listens on during consent. Change only if 8766 is taken.
# GOOGLE_OAUTH_REDIRECT_PORT=8766

# --- WordPress (Example Court RTM site / any WP site) ---
# WP Application Password: WP Admin → Users → Profile → Application Passwords → Add New
# WP_URL=https://example.org
# WP_USERNAME=alex
# WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
# Plugin source directory (default: ~/mongoose-plugin)
# MONGOOSE_PLUGIN_DIR=~/my-rtm-plugin
